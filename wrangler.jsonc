{
  // Cloudflare Workers static site: serves everything in ./site
  "name": "giorgosbatzios",
  "compatibility_date": "2026-09-01",
  "main": "worker.js",
  // Every deploy (live and preview) first rebuilds ./site from source/content.json,
  // so edits saved by GB EDITOR always show up. Pillow is only needed for the share-preview cards.
  "build": { "command": "pip install -q pillow; python3 source/build.py" },
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  // Draft copies: pushes to any branch other than main get their own preview address
  "previews": {},
  "routes": [
    { "pattern": "giorgosbatzios.com", "custom_domain": true },
    { "pattern": "www.giorgosbatzios.com", "custom_domain": true },
    { "pattern": "editor.giorgosbatzios.com", "custom_domain": true }
  ]
}
