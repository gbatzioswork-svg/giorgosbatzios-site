{
  // Cloudflare Workers static site: serves everything in ./site
  "name": "giorgosbatzios",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  // Draft copies: pushes to any branch other than main get their own preview address
  "previews": {},
  "routes": [
    { "pattern": "giorgosbatzios.com", "custom_domain": true },
    { "pattern": "www.giorgosbatzios.com", "custom_domain": true }
  ]
}
